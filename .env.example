# Firebase (valores públicos usados pelo app web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL pública da aplicação (sem barra no final).
APP_URL=http://localhost:5173

# Firebase Admin (JSON da conta de serviço codificado em base64, somente no servidor).
# Necessário para operações administrativas executadas no servidor.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Stripe (assinatura do plano Pro da plataforma; somente no servidor)
STRIPE_SECRET_KEY=sk_test_...
# ID de um preço recorrente ativo (price_) ou produto com preço padrão (prod_).
STRIPE_PRO_PRICE_ID=price_...
# Assinatura dos eventos de contas conectadas e pagamentos das lojas.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
