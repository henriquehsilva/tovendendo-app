# Firebase (valores públicos usados pelo app web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mercado Pago OAuth (credenciais da SUA aplicação integradora).
# Cada lojista conecta a própria conta no painel; não coloque tokens de lojistas aqui.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Segredo longo e aleatório usado para assinar o parâmetro state do OAuth.
MERCADO_PAGO_OAUTH_STATE_SECRET=
# URL pública usada no callback, nos retornos e nas notificações (sem barra final).
APP_URL=http://localhost:5173
# Exemplo cadastrado no Mercado Pago: https://seu-dominio.com/.netlify/functions/mercadopago-callback

# Firebase Admin (JSON da conta de serviço codificado em base64, somente no servidor).
# Necessário para validar o lojista, guardar tokens OAuth e atualizar estoque via webhook.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Stripe (assinatura do plano Pro da plataforma; somente no servidor)
STRIPE_SECRET_KEY=sk_test_...
# ID de um preço recorrente ativo, começando com price_.
STRIPE_PRO_PRICE_ID=price_...
